{"nodes": [{"id": "art_prompt_carte_stile_comune", "label": "Common art style directive", "file_type": "rationale", "source_file": "art/PROMPT-CARTE.txt", "source_location": "every PROMPT line", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every prompt repeats the same opening clause (painterly dark-fantasy oil painting, dramatic chiaroscuro, rich jewel tones, subtle stained-glass light rays, gothic cathedral mood, visible brushstrokes) and the same negative tail (no text, letters, numbers, logo, watermark, signature, frame, border, card template, UI) so independently generated images stay a coherent set and never bake in card chrome the UI already draws."}, {"id": "art_prompt_carte_full_art_verticale", "label": "Full-art vertical 5:7 format", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "lines 5-187", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recommended format because it matches the game's Illustrata style; the subject is pushed into the upper two thirds and the lower third kept dark, calm and low-detail so rules text can be laid over the art."}, {"id": "art_prompt_carte_illustrazione_orizzontale", "label": "Horizontal 4:3 classic frame format", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "lines 189-371", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Alternative classic inset illustration: single centred subject, readable at small size \u2014 no text-safe zone needed because the frame keeps text outside the art."}, {"id": "art_prompt_carte_animazione", "label": "Image-to-video looping animation prompts", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "lines 373-556", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Feed the finished full-art image back into an image-to-video model: 4 second seamless loop, static camera, subject keeps its exact shape and pose with only a slow breathing motion, so the animated card stays recognisably the same card."}, {"id": "art_prompt_carte_vulkara", "label": "Vulkara, Cuore del Monte (brace-l0)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 48", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_thalassa", "label": "Thalassa, Voce degli Abissi (marea-l0)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 93", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_yggrin", "label": "Yggrin, l'Albero che Cammina (radice-l0)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 138", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_nyxa", "label": "Nyxa, Regina del Nulla (vuoto-l0)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 183", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_il_primo_fuoco", "label": "Il Primo Fuoco (brace-l1)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 51", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_fenice_minore", "label": "Fenice Minore (brace-r0)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 39", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_lupa_grigia", "label": "Lupa Grigia (radice-u3)", "file_type": "concept", "source_file": "art/PROMPT-CARTE.txt", "source_location": "line 126", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "art_prompt_carte_orsa_madre", "label"