{
  "name": "rosarcana",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode single",
    "preview": "vite preview",
    "icons": "node scripts/extract-icons.mjs",
    "art": "node scripts/generate-art.mjs",
    "typecheck": "tsc -b",
    "sim": "esbuild scripts/sim-balance.ts --bundle --platform=node --outfile=node_modules/.cache/sim-balance.cjs --log-level=warning && node node_modules/.cache/sim-balance.cjs",
    "sim:arch": "esbuild scripts/sim-archetypes.ts --bundle --platform=node --outfile=node_modules/.cache/sim-archetypes.cjs --log-level=warning && node node_modules/.cache/sim-archetypes.cjs"
  },
  "dependencies": {
    "d3-delaunay": "^6.0.4",
    "framer-motion": "^11.11.17",
    "peerjs": "^1.5.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@iconify-json/game-icons": "^1.2.4",
    "@types/d3-delaunay": "^6.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
